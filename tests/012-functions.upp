# Функції
функція додай(а, б)
    повернути а додати б

функція квадрат(х) то
    повернути х помножити х

функція привітання()
    показати "привіт із функції"

функція факторіал(н)
    якщо н не більше 1 то
        повернути 1
    повернути н помножити факторіал(н відняти 1)

# Взаємна рекурсія: парність через дві функції
функція парне(н)
    якщо н дорівнює 0 то
        повернути правда
    повернути непарне(н відняти 1)

функція непарне(н)
    якщо н дорівнює 0 то
        повернути брехня
    повернути парне(н відняти 1)

показати додай(2, 3)
показати квадрат(5)
привітання()
показати факторіал(5)
показати парне(10)
показати непарне(10)

# Функція без «повернути» дає «ніщо»
нехай нічого буде привітання()
показати нічого

# Функція як значення
показати додай
