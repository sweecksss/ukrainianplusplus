# Списки
нехай числа буде [1, 2, 3]
показати числа
показати довжина(числа)
показати числа[0]
показати числа[2]

числа[1] стає 99
показати числа

додати_до(числа, 4)
показати числа
показати довжина(числа)

нехай мішаний буде [1, "два", правда, 4.5]
показати мішаний

нехай порожній буде []
показати порожній
показати довжина(порожній)

показати [1, 2] додати [3, 4]

# Списки — посилальний тип
нехай другий буде числа
додати_до(другий, 100)
показати числа
