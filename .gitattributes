# Скрипти оболонки МАЮТЬ зберігатися з LF навіть при роботі з Windows.
# Якщо CR потрапить у файл, `curl -fsSL .../install.sh | bash` впаде на
# Linux з «$'\r': command not found». Зараз це забезпечує налаштування
# core.autocrlf розробника — тут ми робимо цю умову явною вимогою
# репозиторію, яка не залежить від чиїхось локальних налаштувань.
*.sh text eol=lf

# Батники читає cmd.exe, якому звичніші CRLF.
*.bat text eol=crlf

# Файли мовою U++ і тести читає інтерпретатор, який розуміє обидва
# варіанти, але LF робить diff однаковим на всіх машинах.
*.upp      text eol=lf
*.expected text eol=lf
*.stdin    text eol=lf

# Двійкові файли git не має чіпати взагалі.
*.exe   binary
*.vsix  binary
*.zip   binary
*.ico   binary
*.res   binary
*.png   binary

# Згенерований масив байтів інсталятора: майже мегабайт тексту, тож
# зайва зміна закінчень рядків роздула б кожен коміт.
upp_bytes.inc text eol=lf
