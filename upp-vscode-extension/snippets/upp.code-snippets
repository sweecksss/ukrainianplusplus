{
  "Оголошення змінної": {
    "prefix": "нехай",
    "body": [
      "нехай ${1:назва} буде ${2:значення}"
    ],
    "description": "Оголошення змінної"
  },
  "Присвоєння": {
    "prefix": "стає",
    "body": [
      "${1:назва} стає ${2:значення}"
    ],
    "description": "Зміна значення наявної змінної"
  },
  "Вивід": {
    "prefix": "показати",
    "body": [
      "показати ${1:вираз}"
    ],
    "description": "Вивід значення"
  },
  "Умова": {
    "prefix": "якщо",
    "body": [
      "якщо ${1:умова} то",
      "\t${2}"
    ],
    "description": "Умовний оператор"
  },
  "Умова з інакше": {
    "prefix": "якщоінакше",
    "body": [
      "якщо ${1:умова} то",
      "\t${2}",
      "інакше то",
      "\t${3}"
    ],
    "description": "Умовний оператор з гілкою інакше"
  },
  "Цикл": {
    "prefix": "поки",
    "body": [
      "поки ${1:умова} то",
      "\t${2}"
    ],
    "description": "Цикл поки"
  },
  "Лічильник": {
    "prefix": "лічильник",
    "body": [
      "нехай ${1:і} буде 0",
      "поки ${1:і} менше ${2:10} то",
      "\t${3}",
      "\t${1:і} стає ${1:і} додати 1"
    ],
    "description": "Цикл-лічильник від нуля"
  },
  "Функція": {
    "prefix": "функція",
    "body": [
      "функція ${1:назва}(${2:параметри})",
      "\t${3}",
      "\tповернути ${4:значення}"
    ],
    "description": "Оголошення функції"
  },
  "Повернути": {
    "prefix": "повернути",
    "body": [
      "повернути ${1:значення}"
    ],
    "description": "Повернення значення з функції"
  },
  "Список": {
    "prefix": "список",
    "body": [
      "нехай ${1:назва} буде [${2:1, 2, 3}]"
    ],
    "description": "Створення списку"
  },
  "Обхід списку": {
    "prefix": "обхід",
    "body": [
      "нехай ${1:і} буде 0",
      "поки ${1:і} менше довжина(${2:список}) то",
      "\tпоказати ${2:список}[${1:і}]",
      "\t${1:і} стає ${1:і} додати 1"
    ],
    "description": "Обхід елементів списку"
  },
  "Введення": {
    "prefix": "ввести",
    "body": [
      "нехай ${1:значення} буде ввести(\"${2:Підказка: }\")"
    ],
    "description": "Читання рядка з клавіатури"
  },
  "правда": {
    "prefix": "правда",
    "body": ["правда"],
    "description": "Булеве значення «правда»"
  },
  "брехня": {
    "prefix": "брехня",
    "body": ["брехня"],
    "description": "Булеве значення «брехня»"
  }
}
