{
  "scopeName": "source.upp",
  "name": "U++",
  "patterns": [
    {
      "name": "comment.line.number-sign.upp",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.upp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.upp",
          "match": "\\\\."
        },
        {
          "name": "variable.other.interpolation.upp",
          "match": "\\{[^}]*\\}"
        }
      ]
    },
    {
      "name": "constant.numeric.upp",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "storage.type.function.upp",
      "match": "(?<![\\p{L}\\p{N}_])(функція)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.upp",
      "match": "(?<![\\p{L}\\p{N}_])(якщо|інакше|поки|то|повернути)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.declaration.upp",
      "match": "(?<![\\p{L}\\p{N}_])(нехай|буде|стає|показати)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.comparison.upp",
      "match": "(?<![\\p{L}\\p{N}_])не\\s+(дорівнює|менше|більше)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.logical.upp",
      "match": "(?<![\\p{L}\\p{N}_])(і|та|або|не)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.upp",
      "match": "(?<![\\p{L}\\p{N}_])(додати|відняти|помножити|поділити|більше|менше|дорівнює)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.boolean.upp",
      "match": "(?<![\\p{L}\\p{N}_])(правда|брехня)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.builtin.upp",
      "match": "(?<![\\p{L}\\p{N}_])(довжина|ввести|число|текст|додати_до)(?=\\s*\\()"
    },
    {
      "name": "entity.name.function.upp",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.arithmetic.upp",
      "match": "-"
    },
    {
      "name": "punctuation.separator.upp",
      "match": "[,\\[\\]()]"
    },
    {
      "name": "variable.other.upp",
      "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
    }
  ],
  "repository": {},
  "fileTypes": [
    "upp"
  ],
  "uuid": "e4b0d0c4-5f29-4c9d-9b1a-upp-000000000001"
}
